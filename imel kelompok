<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Toko Bangunan Vera</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #F1ECE1;
    --paper-2: #E7DFCF;
    --card: #FFFFFF;
    --ink: #221F1C;
    --ink-soft: #59524A;
    --brick: #9C4A34;
    --brick-dark: #7A3A29;
    --safety: #D89A2A;
    --steel: #4C5A63;
    --line: rgba(34,31,28,0.14);
    --good: #3E7A4B;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-sizing: border-box;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --paper: #1B1815;
      --paper-2: #242019;
      --card: #26221D;
      --ink: #F1ECE1;
      --ink-soft: #C7BFB2;
      --brick: #C6694D;
      --brick-dark: #E08A6C;
      --safety: #E9B857;
      --steel: #9AA7AF;
      --line: rgba(241,236,225,0.14);
      --good: #6FBE7F;
    }
  }
  :root[data-theme="dark"] {
    --paper: #1B1815;
    --paper-2: #242019;
    --card: #26221D;
    --ink: #F1ECE1;
    --ink-soft: #C7BFB2;
    --brick: #C6694D;
    --brick-dark: #E08A6C;
    --safety: #E9B857;
    --steel: #9AA7AF;
    --line: rgba(241,236,225,0.14);
    --good: #6FBE7F;
  }
  * { box-sizing: border-box; }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  html, body { height: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 15.5px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  h1,h2,h3,h4 { font-family: 'Archivo', sans-serif; margin: 0; line-height: 1.1; color: var(--ink); }
  p { margin: 0 0 .8em 0; }
  a { color: inherit; }
  button { font-family: inherit; cursor: pointer; }
  img, svg { display: block; max-width: 100%; }

  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }

  /* ---- Header / signboard ---- */
  header.top {
    background: var(--ink);
    color: var(--paper);
    padding-top: env(safe-area-inset-top, 0px);
    position: sticky; top: 0; z-index: 40;
    border-bottom: 4px solid var(--brick);
  }
  .signboard {
    display: flex; align-items: center; justify-content: space-between;
    padding: 26px 20px; max-width: 1080px; margin: 0 auto; gap: 14px; flex-wrap: wrap;
  }
  .brandmark { display: flex; align-items: center; gap: 18px; }
  .brandmark .badge {
    width: 64px; height: 64px; border-radius: 14px; background: var(--brick);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .brandmark .badge svg { width: 36px; height: 36px; stroke: #fff; }
  .brandmark .name { font-family: 'Archivo'; font-weight: 800; font-size: 1.9rem; letter-spacing: -0.01em; color: #fff; }
  .brandmark .tag { font-size: .92rem; color: var(--paper-2); opacity: .8; margin-top: 2px; }

  nav.tabs { display: flex; gap: 6px; overflow-x: auto; padding: 4px 20px 20px; max-width: 1080px; margin: 0 auto; scrollbar-width: none; }
  nav.tabs::-webkit-scrollbar { display: none; }
  nav.tabs button {
    background: transparent; border: 1px solid rgba(241,236,225,0.22); color: var(--paper);
    padding: 11px 20px; border-radius: 999px; font-size: .95rem; font-weight: 600; white-space: nowrap;
    display: flex; align-items: center; gap: 7px; transition: background .15s, border-color .15s;
  }
  nav.tabs button .n { font-family: 'Archivo'; font-weight: 700; opacity: .55; font-size: .78rem; }
  nav.tabs button.active { background: var(--brick); border-color: var(--brick); }
  nav.tabs button:not(.active):hover { border-color: rgba(241,236,225,0.5); }

  main { max-width: 1080px; margin: 0 auto; padding: 44px 20px 90px; }
  section.panel { display: none; }
  section.panel.active { display: block; animation: rise .38s ease; }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  .eyebrow { font-size: .8rem; color: var(--brick); font-weight: 600; margin-bottom: 10px; }
  h2.title { font-size: clamp(1.7rem, 3.4vw, 2.5rem); font-weight: 800; letter-spacing: -0.015em; margin-bottom: 16px; max-width: 16ch; }
  .lede { color: var(--ink-soft); max-width: 58ch; font-size: 1.02rem; }

  /* ---- Sejarah ---- */
  .history-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 44px; align-items: start; margin-top: 28px; }
  @media (max-width: 820px) { .history-grid { grid-template-columns: 1fr; } }
  .story p { color: var(--ink-soft); }
  .photo-stack { display: grid; gap: 16px; }
  .photo {
    aspect-ratio: 4/3; border-radius: 14px; position: relative; overflow: hidden;
    background: linear-gradient(135deg, var(--paper-2), var(--card));
    border: 1px solid var(--line);
    display: flex; align-items: flex-end; padding: 14px;
  }
  .photo.small { aspect-ratio: 16/9; }
  .photo::before {
    content: ""; position: absolute; inset: 0;
    background-image: repeating-linear-gradient(45deg, rgba(34,31,28,0.045) 0 2px, transparent 2px 18px);
  }
  .photo .cap { position: relative; z-index: 1; display: flex; align-items: center; gap: 8px; background: var(--ink); color: var(--paper); padding: 6px 11px; border-radius: 999px; font-size: .74rem; font-weight: 600; }
  .photo .cap svg { width: 14px; height: 14px; stroke: var(--paper); }
  .photo .placeholder-icon { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-58%); opacity: .28; }
  .photo .placeholder-icon svg { width: 54px; height: 54px; stroke: var(--ink); }
  .photo-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }

  .timeline { margin-top: 40px; border-top: 1px solid var(--line); padding-top: 28px; }
  .timeline h3 { font-size: 1rem; margin-bottom: 18px; }
  .tl-row { display: grid; grid-template-columns: 90px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px dashed var(--line); }
  .tl-row:last-child { border-bottom: none; }
  .tl-year { font-family: 'Archivo'; font-weight: 800; color: var(--brick); font-size: 1.05rem; }
  .tl-text { color: var(--ink-soft); font-size: .93rem; }
  .tl-text b { color: var(--ink); font-weight: 600; }

  /* ---- Owner ---- */
  .owner-grid { display: grid; grid-template-columns: 320px 1fr; gap: 40px; margin-top: 28px; align-items: start; }
  @media (max-width: 780px) { .owner-grid { grid-template-columns: 1fr; } }
  .owner-photo {
    aspect-ratio: 3/4; border-radius: 16px; background: linear-gradient(160deg, var(--paper-2), var(--card));
    border: 1px solid var(--line); position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }
  .owner-photo::before { content:""; position:absolute; inset:0; background-image: repeating-linear-gradient(45deg, rgba(34,31,28,0.045) 0 2px, transparent 2px 18px); }
  .owner-photo svg { width: 76px; height: 76px; stroke: var(--ink); opacity: .3; position: relative; z-index:1; }
  .owner-photo .cap { position: absolute; bottom: 14px; left: 14px; z-index:1; background: var(--ink); color: var(--paper); padding: 6px 11px; border-radius: 999px; font-size: .74rem; font-weight: 600; }

  .biodata { border: 1px solid var(--line); border-radius: 14px; background: var(--card); padding: 4px 0; margin: 22px 0; }
  .biodata .row { display: grid; grid-template-columns: 140px 1fr; gap: 10px; padding: 11px 18px; border-bottom: 1px solid var(--line); font-size: .92rem; }
  .biodata .row:last-child { border-bottom: none; }
  .biodata .row span:first-child { color: var(--ink-soft); }
  .biodata .row span:last-child { font-weight: 600; }

  .quote { border-left: 3px solid var(--brick); padding: 4px 0 4px 16px; color: var(--ink-soft); font-style: italic; margin: 18px 0; }

  /* ---- Produk ---- */
  .catalog-controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 24px 0 20px; }
  .search-box { position: relative; flex: 1; min-width: 220px; }
  .search-box input {
    width: 100%; padding: 11px 14px 11px 38px; border-radius: 10px; border: 1px solid var(--line);
    background: var(--card); color: var(--ink); font-size: .92rem; font-family: inherit;
  }
  .search-box input:focus { outline: 2px solid var(--brick); outline-offset: 1px; }
  .search-box svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; stroke: var(--ink-soft); }

  .chips { display: flex; gap: 7px; flex-wrap: wrap; margin-bottom: 22px; }
  .chip {
    border: 1px solid var(--line); background: var(--card); color: var(--ink-soft);
    padding: 6px 13px; border-radius: 999px; font-size: .8rem; font-weight: 600;
  }
  .chip.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 14px; }
  .p-card { border: 1px solid var(--line); background: var(--card); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
  .p-photo { aspect-ratio: 4/3; background: var(--paper-2); position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .p-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .p-photo svg { width: 30px; height: 30px; stroke: var(--brick); opacity: .45; }
  .p-body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .p-cat { font-size: .68rem; text-transform: none; color: var(--steel); font-weight: 600; }
  .p-name { font-weight: 700; font-size: .93rem; line-height: 1.3; min-height: 2.4em; }
  .p-price { font-family: 'Archivo'; font-weight: 800; color: var(--brick-dark); font-size: 1.02rem; margin-top: auto; }
  .p-price small { font-family: 'IBM Plex Sans'; font-weight: 500; color: var(--ink-soft); font-size: .72rem; }
  .p-actions { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
  .stepper { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .stepper button { background: var(--paper-2); border: none; width: 28px; height: 30px; font-size: 1rem; color: var(--ink); }
  .stepper span { width: 30px; text-align: center; font-weight: 700; font-size: .85rem; }
  .add-btn { flex: 1; background: var(--ink); color: var(--paper); border: none; border-radius: 8px; height: 30px; font-size: .78rem; font-weight: 700; }
  .add-btn:hover { background: var(--brick); }
  .no-results { grid-column: 1/-1; text-align: center; padding: 40px 0; color: var(--ink-soft); }

  .float-cart {
    position: fixed; right: 18px; bottom: calc(18px + env(safe-area-inset-bottom, 0px)); z-index: 50;
    background: var(--ink); color: var(--paper); border: none; border-radius: 999px;
    padding: 12px 18px; display: flex; align-items: center; gap: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.28);
    font-weight: 700; font-size: .85rem;
  }
  .float-cart svg { width: 18px; height: 18px; stroke: var(--paper); }
  .float-cart .count { background: var(--brick); color: #fff; border-radius: 999px; padding: 1px 8px; font-size: .74rem; }
  .float-cart.hide { display: none; }

  /* ---- Keranjang (menyatu di tab Produk) ---- */
  .cart-section { border-top: 1px solid var(--line); margin-top: 40px; padding-top: 32px; scroll-margin-top: 190px; }
  .cart-heading { font-size: 1.3rem; font-weight: 800; margin-bottom: 6px; }
  .cart-layout { display: grid; grid-template-columns: 1.2fr .8fr; gap: 32px; margin-top: 26px; align-items: start; }
  @media (max-width: 820px) { .cart-layout { grid-template-columns: 1fr; } }
  .cart-list { display: flex; flex-direction: column; gap: 10px; }
  .cart-empty { border: 1px dashed var(--line); border-radius: 14px; padding: 40px 20px; text-align: center; color: var(--ink-soft); }
  .cart-item { display: grid; grid-template-columns: 40px 1fr auto auto; gap: 12px; align-items: center; border: 1px solid var(--line); background: var(--card); border-radius: 12px; padding: 10px 12px; }
  .cart-item .ci-icon { width: 36px; height: 36px; border-radius: 8px; background: var(--paper-2); display: flex; align-items: center; justify-content: center; }
  .cart-item .ci-icon svg { width: 18px; height: 18px; stroke: var(--brick); }
  .cart-item .ci-name { font-weight: 600; font-size: .87rem; }
  .cart-item .ci-unit { font-size: .74rem; color: var(--ink-soft); }
  .cart-item .ci-sub { font-family: 'Archivo'; font-weight: 700; font-size: .87rem; white-space: nowrap; }
  .ci-remove { background: none; border: none; color: var(--ink-soft); font-size: 1.1rem; line-height: 1; padding: 4px; }
  .ci-remove:hover { color: var(--brick); }

  .summary-box { border: 1px solid var(--line); background: var(--card); border-radius: 14px; padding: 20px; position: sticky; top: 190px; }
  .summary-box h3 { font-size: .98rem; margin-bottom: 14px; }
  .sum-row { display: flex; justify-content: space-between; font-size: .88rem; padding: 6px 0; color: var(--ink-soft); }
  .sum-row.total { border-top: 1px solid var(--line); margin-top: 6px; padding-top: 12px; font-weight: 800; color: var(--ink); font-size: 1.05rem; font-family: 'Archivo'; }

  .pay-methods { display: grid; gap: 9px; margin: 16px 0; }
  .pay-opt { border: 1px solid var(--line); border-radius: 10px; padding: 11px 13px; display: flex; align-items: center; gap: 10px; background: var(--paper-2); }
  .pay-opt input { accent-color: var(--brick); width: 16px; height: 16px; }
  .pay-opt label { font-weight: 600; font-size: .87rem; flex: 1; cursor: pointer; }
  .pay-opt.checked { border-color: var(--brick); background: color-mix(in srgb, var(--brick) 10%, var(--card)); }

  .pay-detail { border: 1px dashed var(--line); border-radius: 10px; padding: 14px; font-size: .82rem; color: var(--ink-soft); margin-bottom: 14px; display: none; }
  .pay-detail.show { display: block; }
  .qr-box { width: 118px; height: 118px; margin: 0 auto 10px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line); }
  .qr-box svg { width: 100%; height: 100%; }

  .checkout-btn { width: 100%; background: var(--brick); color: #fff; border: none; border-radius: 10px; padding: 13px; font-weight: 700; font-size: .92rem; }
  .checkout-btn:hover { background: var(--brick-dark); }
  .checkout-btn:disabled { opacity: .45; cursor: not-allowed; }
  .cart-note { font-size: .74rem; color: var(--ink-soft); margin-top: 10px; text-align: center; }

  .receipt { border: 1px solid var(--line); background: var(--card); border-radius: 14px; padding: 20px; margin-top: 18px; display: none; }
  .receipt.show { display: block; }
  .receipt h4 { font-size: .92rem; margin-bottom: 4px; }
  .receipt .rid { font-size: .74rem; color: var(--ink-soft); margin-bottom: 12px; }
  .receipt .r-row { display: flex; justify-content: space-between; font-size: .82rem; padding: 5px 0; border-bottom: 1px dashed var(--line); }
  .receipt .r-total { font-weight: 800; font-family: 'Archivo'; display: flex; justify-content: space-between; padding-top: 10px; font-size: .98rem; }
  .receipt .r-badge { display: inline-flex; align-items: center; gap: 6px; background: color-mix(in srgb, var(--good) 15%, var(--card)); color: var(--good); padding: 4px 10px; border-radius: 999px; font-size: .74rem; font-weight: 700; margin-top: 10px; }

  .waiting-question { font-weight: 600; font-size: .9rem; margin: 16px 0 10px; text-align: center; }
  .waiting-actions { display: grid; gap: 8px; }
  .btn-secondary { width: 100%; background: transparent; color: var(--ink-soft); border: 1px solid var(--line); border-radius: 10px; padding: 12px; font-weight: 600; font-size: .87rem; }
  .btn-secondary:hover { border-color: var(--brick); color: var(--brick); }

  .result-title { font-family: 'Archivo'; font-weight: 900; font-size: 1.3rem; text-align: center; padding: 8px 0 4px; }
  .result-title.success { color: var(--good); }
  .result-title.fail { color: var(--brick-dark); }
  #resultFail { text-align: center; }
  #resultFail p { margin: 10px 0 16px; }

  /* ---- Rating ---- */
  .rating-summary { display: grid; grid-template-columns: auto 1fr; gap: 36px; align-items: center; margin: 26px 0 34px; }
  @media (max-width: 620px) { .rating-summary { grid-template-columns: 1fr; text-align: center; } }
  .avg-num { font-family: 'Archivo'; font-weight: 900; font-size: 3.6rem; line-height: 1; color: var(--ink); }
  .avg-stars { color: var(--safety); font-size: 1.2rem; margin: 6px 0; }
  .avg-sub { font-size: .8rem; color: var(--ink-soft); }
  .bars { display: flex; flex-direction: column; gap: 6px; }
  .bar-row { display: grid; grid-template-columns: 40px 1fr 30px; gap: 8px; align-items: center; font-size: .78rem; color: var(--ink-soft); }
  .bar-track { height: 7px; background: var(--paper-2); border-radius: 999px; overflow: hidden; }
  .bar-fill { height: 100%; background: var(--safety); }

  .review-form { border: 1px solid var(--line); background: var(--card); border-radius: 14px; padding: 20px; margin-bottom: 28px; }
  .review-form h3 { font-size: 1rem; margin-bottom: 14px; }
  .star-pick { display: flex; gap: 6px; margin-bottom: 14px; }
  .star-pick button { background: none; border: none; font-size: 1.7rem; color: var(--line); line-height: 1; padding: 0; }
  .star-pick button.on { color: var(--safety); }
  .review-form input, .review-form textarea {
    width: 100%; border: 1px solid var(--line); border-radius: 9px; padding: 10px 12px; font-family: inherit;
    font-size: .88rem; background: var(--paper-2); color: var(--ink); margin-bottom: 10px;
  }
  .review-form textarea { min-height: 78px; resize: vertical; }
  .review-form button.submit { background: var(--ink); color: var(--paper); border: none; border-radius: 9px; padding: 11px 18px; font-weight: 700; font-size: .85rem; }
  .review-form button.submit:hover { background: var(--brick); }

  .review-list { display: flex; flex-direction: column; gap: 12px; }
  .review { border: 1px solid var(--line); background: var(--card); border-radius: 12px; padding: 15px 16px; }
  .review .r-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
  .review .r-name { font-weight: 700; font-size: .88rem; }
  .review .r-stars { color: var(--safety); font-size: .85rem; letter-spacing: 1px; }
  .review .r-text { color: var(--ink-soft); font-size: .87rem; }
  .review .r-tag { font-size: .7rem; color: var(--steel); margin-top: 6px; }

  footer.site {
    border-top: 1px solid var(--line); margin-top: 40px; padding: 30px 20px 50px;
    background: var(--paper-2);
  }
  .foot-grid { max-width: 1080px; margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; }
  .foot-grid .b { font-family:'Archivo'; font-weight: 800; margin-bottom: 6px; }
  .foot-grid .s { font-size: .82rem; color: var(--ink-soft); }
  .foot-grid div { min-width: 180px; }

  .sr-only { position: absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }
  :focus-visible { outline: 2px solid var(--brick); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
<defs>
<symbol id="ic-brick" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="8" height="6"/><rect x="13" y="7" width="8" height="6"/><rect x="7" y="13" width="8" height="6"/><line x1="3" y1="13" x2="7" y2="13"/><line x1="15" y1="13" x2="21" y2="13"/></symbol>
<symbol id="ic-bucket" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-2 11H7L5 8z"/><path d="M3 8h18"/><path d="M9 8V5a3 3 0 0 1 6 0v3"/><path d="M9 13c0 1.5 1 2 1.5 2.5"/></symbol>
<symbol id="ic-nail" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 5h12v3H6z"/><line x1="12" y1="8" x2="12" y2="20"/><path d="M12 20l-2.4-3"/><path d="M12 20l2.4-3"/></symbol>
<symbol id="ic-wrench" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 1 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2-2z"/></symbol>
