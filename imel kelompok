  cats.forEach(function(c){
    var chip = document.createElement("button");
    chip.className = "chip" + (c === "Semua" ? " active" : "");
    chip.textContent = c;
    chip.addEventListener("click", function(){
      activeCat = c;
      chipsWrap.querySelectorAll(".chip").forEach(function(x){ x.classList.remove("active"); });
      chip.classList.add("active");
      renderProducts();
    });
    chipsWrap.appendChild(chip);
  });

  document.getElementById("searchInput").addEventListener("input", function(e){
    searchTerm = e.target.value.trim().toLowerCase();
    renderProducts();
  });

  function qtyOf(id){ return cart[id] ? cart[id].qty : 0; }

  function renderProducts(){
    var grid = document.getElementById("productGrid");
    var list = PRODUCTS.filter(function(p){
      var matchCat = activeCat === "Semua" || p.cat === activeCat;
      var matchSearch = !searchTerm || p.name.toLowerCase().indexOf(searchTerm) !== -1;
      return matchCat && matchSearch;
    });
    grid.innerHTML = "";
    if (!list.length){
      grid.innerHTML = '<div class="no-results">Produk tidak ditemukan. Coba kata kunci lain.</div>';
      return;
    }
    list.forEach(function(p){
      var icon = ICON_BY_CAT[p.cat] || "ic-brick";
      var q = qtyOf(p.id);
      var card = document.createElement("div");
      card.className = "p-card";
      var photoInner = (p.img && p.img.trim() !== "")
        ? '<img src="'+p.img+'" alt="'+p.name+'">'
        : '<svg viewBox="0 0 24 24" fill="none"><use href="#'+icon+'"/></svg>';
      card.innerHTML =
        '<div class="p-photo">'+photoInner+'</div>' +
        '<div class="p-body">' +
        '<div class="p-cat">'+p.cat+'</div>' +
        '<div class="p-name">'+p.name+'</div>' +
        '<div class="p-price">'+fmtRupiah(p.price)+(p.unit ? ' <small>/ '+p.unit+'</small>' : '')+'</div>' +
        '<div class="p-actions">' +
          '<div class="stepper">' +
            '<button type="button" data-act="dec" data-id="'+p.id+'">&minus;</button>' +
            '<span id="qty-'+p.id+'">'+q+'</span>' +
            '<button type="button" data-act="inc" data-id="'+p.id+'">+</button>' +
          '</div>' +
          '<button type="button" class="add-btn" data-add="'+p.id+'">Tambah</button>' +
        '</div>' +
        '</div>';
      grid.appendChild(card);
    });

    grid.querySelectorAll('[data-act]').forEach(function(btn){
      btn.addEventListener("click", function(){
        var id = btn.dataset.id;
        var span = document.getElementById("qty-"+id);
        var v = parseInt(span.textContent, 10);
        if (btn.dataset.act === "inc") v++;
        else v = Math.max(0, v - 1);
        span.textContent = v;
      });
    });
    grid.querySelectorAll('[data-add]').forEach(function(btn){
      btn.addEventListener("click", function(){
        var id = parseInt(btn.dataset.add, 10);
        var span = document.getElementById("qty-"+id);
        var v = parseInt(span.textContent, 10);
        if (v <= 0) v = 1;
        var product = PRODUCTS.find(function(p){ return p.id === id; });
        cart[id] = {qty: v, name: product.name, price: product.price, unit: product.unit, cat: product.cat};
        safeSet("vera_cart_v1", cart);
        renderCart();
        renderFloatCart();
        btn.textContent = "Ditambahkan";
        setTimeout(function(){ btn.textContent = "Tambah"; }, 900);
      });
    });
  }

  // ---------- Keranjang ----------
  function cartCount(){
    return Object.keys(cart).reduce(function(sum, id){ return sum + cart[id].qty; }, 0);
  }
  function cartTotal(){
    return Object.keys(cart).reduce(function(sum, id){ return sum + cart[id].qty * cart[id].price; }, 0);
  }

  function renderFloatCart(){
    var c = cartCount();
    document.getElementById("floatCount").textContent = c;
    document.getElementById("floatCart").classList.toggle("hide", c === 0);
  }

  function showStep(step){
    // step: "form" | "waiting" | "success" | "fail"
    document.getElementById("stepForm").style.display = step === "form" ? "block" : "none";
    document.getElementById("stepWaiting").style.display = step === "waiting" ? "block" : "none";
    document.getElementById("resultSuccess").style.display = step === "success" ? "block" : "none";
    document.getElementById("resultFail").style.display = step === "fail" ? "block" : "none";
  }

  function renderCart(){
    var wrap = document.getElementById("cartList");
    var ids = Object.keys(cart);
    showStep("form");

    if (!ids.length){
      wrap.innerHTML = '<div class="cart-empty">Keranjang masih kosong. Yuk pilih produk di tab Produk.</div>';
    } else {
      wrap.innerHTML = "";
      ids.forEach(function(id){
        var item = cart[id];
        var icon = ICON_BY_CAT[item.cat] || "ic-brick";
        var row = document.createElement("div");
        row.className = "cart-item";
        row.innerHTML =
          '<div class="ci-icon"><svg viewBox="0 0 24 24" fill="none"><use href="#'+icon+'"/></svg></div>' +
          '<div><div class="ci-name">'+item.name+'</div><div class="ci-unit">'+item.qty+(item.unit? ' '+item.unit : ' pcs')+' &times; '+fmtRupiah(item.price)+'</div></div>' +
          '<div class="ci-sub">'+fmtRupiah(item.qty * item.price)+'</div>' +
          '<button class="ci-remove" data-remove="'+id+'" aria-label="Hapus">&times;</button>';
        wrap.appendChild(row);
      });
      wrap.querySelectorAll('[data-remove]').forEach(function(btn){
        btn.addEventListener("click", function(){
          delete cart[btn.dataset.remove];
          safeSet("vera_cart_v1", cart);
          renderCart();
          renderFloatCart();
          renderProducts();
        });
      });
    }

    document.getElementById("sumCount").textContent = cartCount();
    document.getElementById("sumTotal").textContent = fmtRupiah(cartTotal());
    document.getElementById("checkoutBtn").disabled = ids.length === 0;
  }

  document.getElementById("floatCart").addEventListener("click", function(){
    goTab("produk");
    setTimeout(function(){
      var anchor = document.getElementById("cartAnchor");
      if (anchor) anchor.scrollIntoView({behavior:"smooth"});
    }, 60);
  });

  // ---------- Pembayaran ----------
  document.querySelectorAll('input[name="pay"]').forEach(function(r){
    r.addEventListener("change", function(){
      var checked = document.querySelector('input[name="pay"]:checked').value;
      document.querySelectorAll(".pay-opt").forEach(function(el){
        el.classList.toggle("checked", el.dataset.m === checked);
      });
    });
  });

  var currentOrder = null;

  document.getElementById("checkoutBtn").addEventListener("click", function(){
    var ids = Object.keys(cart);
    if (!ids.length) return;
    var method = document.querySelector('input[name="pay"]:checked').value;
    currentOrder = {
      method: method,
      methodLabel: {dana:"DANA", qris:"QRIS"}[method],
      total: cartTotal(),
      items: ids.map(function(id){ return cart[id]; })
    };
    document.getElementById("detailDana").classList.toggle("show", method === "dana");
    document.getElementById("detailQris").classList.toggle("show", method === "qris");
    document.getElementById("waitingTotal").textContent = fmtRupiah(currentOrder.total);
    showStep("waiting");
  });

  document.getElementById("btnSudah").addEventListener("click", function(){
    if (!currentOrder) return;
    var orderId = "VERA-" + Date.now().toString().slice(-6);
    var now = new Date();
    document.getElementById("receiptId").textContent = "No. Pesanan " + orderId + " \u2022 " + now.toLocaleString("id-ID");
    var itemsHtml = currentOrder.items.map(function(item){
      return '<div class="r-row"><span>'+item.name+' &times;'+item.qty+'</span><span>'+fmtRupiah(item.qty*item.price)+'</span></div>';
    }).join("");
    document.getElementById("receiptItems").innerHTML = itemsHtml;
    document.getElementById("receiptTotal").textContent = fmtRupiah(currentOrder.total);
    document.getElementById("receiptPay").innerHTML = "&#10003; Bayar via " + currentOrder.methodLabel;
    showStep("success");
  });

  document.getElementById("btnBelum").addEventListener("click", function(){
    showStep("fail");
  });

  document.getElementById("btnBackToWaiting").addEventListener("click", function(){
    showStep("waiting");
  });

  document.getElementById("btnNewOrder").addEventListener("click", function(){
    cart = {};
    safeSet("vera_cart_v1", cart);
    currentOrder = null;
    renderCart();
    renderFloatCart();
    renderProducts();
  });

  // ---------- Rating ----------
  function renderRating(){
    var n = reviews.length;
    var avg = n ? reviews.reduce(function(s,r){ return s + r.stars; }, 0) / n : 0;
    document.getElementById("avgNum").textContent = n ? avg.toFixed(1) : "-";
    document.getElementById("avgSub").textContent = n ? ("dari " + n + " ulasan") : "belum ada ulasan";
    document.getElementById("avgStars").innerHTML = starString(Math.round(avg));

    var bars = document.getElementById("bars");
    bars.innerHTML = "";
    for (var s = 5; s >= 1; s--){
      var count = reviews.filter(function(r){ return r.stars === s; }).length;
      var pct = n ? Math.round((count / n) * 100) : 0;
      var row = document.createElement("div");
      row.className = "bar-row";
      row.innerHTML = '<span>'+s+' &#9733;</span><div class="bar-track"><div class="bar-fill" style="width:'+pct+'%"></div></div><span>'+count+'</span>';
      bars.appendChild(row);
    }

    var list = document.getElementById("reviewList");
    list.innerHTML = "";
    reviews.slice().reverse().forEach(function(r){
      var el = document.createElement("div");
      el.className = "review";
      el.innerHTML =
        '<div class="r-head"><span class="r-name">'+escapeHtml(r.name)+'</span><span class="r-stars">'+starString(r.stars)+'</span></div>' +
        '<div class="r-text">'+escapeHtml(r.text)+'</div>' +
        (r.tag ? '<div class="r-tag">'+escapeHtml(r.tag)+'</div>' : '');
      list.appendChild(el);
    });
  }
  function starString(n){
    var out = "";
    for (var i=1;i<=5;i++) out += (i<=n ? "&#9733;" : "&#9734;");
    return out;
  }
  function escapeHtml(s){
    var d = document.createElement("div");
    d.textContent = s;
    return d.innerHTML;
  }

  var starPick = document.getElementById("starPick");
  starPick.querySelectorAll("button").forEach(function(btn){
    btn.addEventListener("click", function(){
      pickedStars = parseInt(btn.dataset.v, 10);
      starPick.querySelectorAll("button").forEach(function(b){
        b.classList.toggle("on", parseInt(b.dataset.v,10) <= pickedStars);
      });
    });
  });

  document.getElementById("submitReview").addEventListener("click", function(){
    var name = document.getElementById("reviewName").value.trim();
    var text = document.getElementById("reviewText").value.trim();
    if (!pickedStars){ alert("Yuk pilih bintang dulu."); return; }
    if (!name){ alert("Isi nama kamu dulu, ya."); return; }
    if (!text){ alert("Tulis sedikit pengalaman kamu."); return; }
    reviews.push({name: name, stars: pickedStars, text: text, tag: "Pelanggan"});
    safeSet("vera_reviews_v1", reviews);
    document.getElementById("reviewName").value = "";
    document.getElementById("reviewText").value = "";
    pickedStars = 0;
    starPick.querySelectorAll("button").forEach(function(b){ b.classList.remove("on"); });
    renderRating();
  });

  // ---------- Init ----------
  renderProducts();
  renderCart();
  renderFloatCart();
  document.querySelector('.pay-opt[data-m="dana"]').classList.add("checked");
  renderRating();
})();
</script>
</body>
</html>